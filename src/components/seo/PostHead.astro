---
export interface Props {
  publishedTime: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
}

const {
  publishedTime,
  modifiedTime,
  author,
  tags = [],
} = Astro.props;

const publishedFormatted = publishedTime.toISOString();
const modifiedFormatted = modifiedTime?.toISOString();
const authorFormatted = author?.trim();
const tagsFormatted = [...new Set(tags.map((tag) => tag.trim()).filter(Boolean))];
---

<meta property="article:published_time" content={publishedFormatted} />
{
  modifiedFormatted && (
    <meta property="article:modified_time" content={modifiedFormatted} />
  )
}
{authorFormatted && <meta name="author" content={authorFormatted} />}
{tagsFormatted.map((tag) => <meta property="article:tag" content={tag} />)}
