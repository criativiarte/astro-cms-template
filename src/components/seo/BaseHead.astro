---
export interface Props {
  title: string;
  description: string;
  imageURL: string;
  imageAlt?: string;
  canonicalURL?: string;
  noindex?: boolean;
  nofollow?: boolean;
  openGraphType?: "website" | "article";
  siteTitle: string;
}

const {
  title,
  description,
  imageURL,
  imageAlt,
  canonicalURL,
  noindex = false,
  nofollow = false,
  openGraphType = "website",
  siteTitle,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Astro.site precisa estar definido no astro.config.mjs.");
}

const pageTitle = title.trim() || siteTitle;
const titleFormatted =
  pageTitle === siteTitle ? siteTitle : `${pageTitle} - ${siteTitle}`;
const descriptionFormatted = description.trim();
const imageFormatted = new URL(imageURL.trim(), Astro.site).toString();
const imageAltFormatted = imageAlt?.trim() || titleFormatted;
const canonicalFormatted = new URL(
  canonicalURL?.trim() || Astro.url.pathname,
  Astro.site,
).toString();

const robots = [
  noindex ? "noindex" : "index",
  nofollow ? "nofollow" : "follow",
  ...(!noindex
    ? ["max-image-preview:large", "max-snippet:-1", "max-video-preview:-1"]
    : []),
].join(", ");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="canonical" href={canonicalFormatted} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{titleFormatted}</title>
<meta name="description" content={descriptionFormatted} />

<meta property="og:type" content={openGraphType} />
<meta property="og:url" content={canonicalFormatted} />
<meta property="og:title" content={titleFormatted} />
<meta property="og:description" content={descriptionFormatted} />
<meta property="og:image" content={imageFormatted} />
<meta property="og:image:alt" content={imageAltFormatted} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalFormatted} />
<meta name="twitter:title" content={titleFormatted} />
<meta name="twitter:description" content={descriptionFormatted} />
<meta name="twitter:image" content={imageFormatted} />
<meta name="twitter:image:alt" content={imageAltFormatted} />
