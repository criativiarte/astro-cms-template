---
import type { ImageMetadata } from "astro";
import { SEO, type JsonLdInput } from "astro-seo-kit";
import { SITE_DESCRIPTION, SITE_IMAGE, SITE_TITLE } from "@/consts";

export interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
}

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  canonicalURL?: string | false;
  noindex?: boolean;
  nofollow?: boolean;
  openGraphType?: "website" | "article";
  article?: ArticleMeta;
  jsonLd?: JsonLdInput;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = SITE_IMAGE,
  imageAlt,
  canonicalURL,
  noindex = false,
  nofollow = false,
  openGraphType,
  article,
  jsonLd,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Astro.site precisa estar definido no astro.config.mjs.");
}

const trimmedTitle = title?.trim();
const pageTitle =
  trimmedTitle && trimmedTitle !== SITE_TITLE ? trimmedTitle : undefined;
const cleanDescription = description.trim();
const resolvedCanonical =
  canonicalURL === false ? false : canonicalURL?.trim() || Astro.url.pathname;

const resolvedImage =
  typeof image === "string"
    ? { url: image.trim() }
    : { url: image.src, width: image.width, height: image.height };

const cleanAuthor = article?.author?.trim();
const cleanTags = article?.tags
  ? [...new Set(article.tags.map((tag) => tag.trim()).filter(Boolean))]
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<SEO
  title={pageTitle}
  titleDefault={SITE_TITLE}
  titleTemplate={`%s - ${SITE_TITLE}`}
  description={cleanDescription}
  canonical={resolvedCanonical}
  {noindex}
  {nofollow}
  robotsProps={!noindex
    ? {
        maxImagePreview: "large",
        maxSnippet: -1,
        maxVideoPreview: -1,
      }
    : undefined}
  image={{
    ...resolvedImage,
    alt: imageAlt?.trim() || pageTitle || SITE_TITLE,
  }}
  openGraph={{
    type: openGraphType,
    siteName: SITE_TITLE,
    locale: "pt_BR",
  }}
  twitter={{
    card: "summary_large_image",
  }}
  article={article
    ? {
        publishedTime: article.publishedTime,
        modifiedTime: article.modifiedTime,
        authors: cleanAuthor ? [cleanAuthor] : undefined,
        tags: cleanTags,
      }
    : undefined}
  articleJsonLd={article ? { "@type": "BlogPosting" } : false}
  {jsonLd}
/>
