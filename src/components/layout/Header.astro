---
import HeaderLink from "@/components/layout/HeaderLink.astro";

type Link = {
  name: string;
  href: string;
};

const links: Link[] = [
  {
    name: "Início",
    href: "/",
  },
  {
    name: "Blog",
    href: "/blog",
  },
];
---

<header class="bg-white border-zinc-200 border-b">
  <nav class="flex justify-between items-center mx-auto px-5 py-4 max-w-5xl">
    <a
      href="/"
      class="font-semibold tracking-tight"
      data-astro-prefetch="hover"
    >
      ASTRO + CMS
    </a>
    <div class="flex items-center gap-4">
      {
        links.map((link) => (
          <HeaderLink href={link.href}>{link.name}</HeaderLink>
        ))
      }
    </div>
  </nav>
</header>
