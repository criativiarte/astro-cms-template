---
import FormattedDate from "@/components/blog/FormattedDate.astro";
import placeholder from "@/assets/images/post-placeholder.png";
import { Image } from "astro:assets";
import { getPostData, type Post } from "@/utils/blog";
import Tags from "@/components/blog/Tags.astro";

interface Props {
  post: Post;
  activeTag?: string;
}

const { post, activeTag } = Astro.props;

const { title, slug, pubDate, coverImage, tags } = getPostData(post);
---

<article class="bg-white border border-zinc-200 rounded-lg overflow-hidden">
  <a href={`/blog/${slug}/`} data-astro-prefetch="hover" class="block">
    <div class="relative border-zinc-200 border-b overflow-hidden">
      <Image
        width={670}
        widths={[320, 480, 670]}
        sizes="(min-width: 1138px) 502px, (min-width: 768px) calc((90vw - 20px) / 2), 90vw"
        src={coverImage ?? placeholder}
        alt={title}
        decoding="async"
        loading="lazy"
        format="webp"
        class="w-full h-full object-center object-cover aspect-video"
      />
      <Tags
        tags={tags}
        class="top-0 right-0 z-50 absolute justify-end m-4"
        activeTag={activeTag}
      />
    </div>
  </a>

  <div class="space-y-1 p-5">
    <a href={`/blog/${slug}/`} data-astro-prefetch="hover" class="block">
      <h2 class="hover:text-zinc-600 heading-3">{title}</h2>
    </a>
    {
      pubDate && (
        <p class="text-zinc-500 text-sm">
          <FormattedDate date={pubDate} />
        </p>
      )
    }
  </div>
</article>
