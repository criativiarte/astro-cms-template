---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/layout/Container.astro";
---

<Layout>
  <Container class="py-16 md:py-24">
    <section class="space-y-6 max-w-3xl">
      <p class="font-semibold text-zinc-500 text-sm uppercase tracking-wide">
        Astro + Sveltia CMS
      </p>
      <h1 class="heading-1">
        Um template simples para publicar conteúdo com Astro.
      </h1>
      <p class="text-zinc-600 text-lg md:text-xl">
        Use esta base como ponto de partida para sites pequenos e blogs
        gerenciados por um CMS Git-backed.
      </p>
      <div class="flex sm:flex-row flex-col gap-3">
        <a class="button button-primary" href="/blog"> Ver posts </a>
        <a class="button button-secondary" href="/admin/" target="_blank">
          Abrir admin
        </a>
      </div>
    </section>

    <section class="gap-4 grid md:grid-cols-3 mt-16">
      <article class="bg-white p-6 border border-zinc-200 rounded-lg">
        <h2 class="heading-3">Estrutura pequena</h2>
        <p class="mt-3 text-zinc-600">
          Páginas, layouts, estilos e helpers ficam separados, mas sem camadas
          desnecessárias.
        </p>
      </article>
      <article class="bg-white p-6 border border-zinc-200 rounded-lg">
        <h2 class="heading-3">Tailwind direto</h2>
        <p class="mt-3 text-zinc-600">
          Classes utilitárias simples para que você consiga trocar o visual
          rapidamente.
        </p>
      </article>
      <article class="bg-white p-6 border border-zinc-200 rounded-lg">
        <h2 class="heading-3">CMS embutido</h2>
        <p class="mt-3 text-zinc-600">
          O painel em /admin publica Markdown em src/content/blog e dispara o
          deploy estatico pelo GitHub.
        </p>
      </article>
    </section>
  </Container>
</Layout>
