---
import "@/styles/global.css";

import BaseHead from "@/components/seo/BaseHead.astro";
import type { Props as BaseHeadProps } from "@/components/seo/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import {
  SITE_DESCRIPTION as site_description,
  SITE_IMAGE as site_image,
  SITE_TITLE as siteTitle,
} from "@/consts";

export type Props = Partial<Omit<BaseHeadProps, "siteTitle">>;

const {
  title = siteTitle,
  description = site_description,
  imageURL = site_image,
  ...props
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead {...props} {title} {description} {imageURL} {siteTitle} />
    <slot name="head" />
  </head>
  <body class="bg-zinc-50 min-h-screen text-zinc-950 antialiased">
    <Header />
    <main class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
