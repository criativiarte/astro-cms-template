---
import "@/styles/global.css";
import { Font } from "astro:assets";

import Head, { type Props as HeadProps } from "@/components/seo/Head.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";

export type Props = HeadProps;

const props = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <Head {...props} />
    <Font cssVariable="--font-atkinson" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <slot name="head" />
  </head>
  <body class="bg-zinc-50 min-h-screen text-zinc-950 antialiased">
    <Header />
    <main class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
